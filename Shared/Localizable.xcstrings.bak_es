    "看着镜头说话\n不用背稿": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "看着镜头说话\n不用背稿"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Look at the lens.\nLeave memorizing behind."
          }
        },
        "zh-Hant": {
