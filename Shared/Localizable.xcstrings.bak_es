    "DOCX 文件损坏、已加密或格式不受支持。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "DOCX 文件损坏、已加密或格式不受支持。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This DOCX file is damaged, encrypted, or uses an unsupported format."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "DOCX 檔案損壞、已加密或格式不受支援。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このDOCXファイルは破損しているか、暗号化されているか、対応していない形式です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 DOCX 파일이 손상되었거나 암호화되었거나 지원하지 않는 형식입니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese DOCX-Datei ist beschädigt, verschlüsselt oder hat ein nicht unterstütztes Format."
          }
        }
      }
    },
    "一次买断": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一次买断"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlock once"
          }
