        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一次買斷"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一度だけで解放"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 번 구매로 잠금 해제"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einmal freischalten"
          }
        }
      }
    },
    "一次买断，持续使用": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一次买断，持续使用"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One purchase. Yours to keep."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一次買斷，持續使用"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一度の購入で、ずっと使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 번 구매로 계속 사용"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Kauf. Für immer deins."
          }
        }
      }
    },
    "一遍过！": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一遍过！"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One take!"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一遍過！"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一発撮り成功！"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원테이크 성공!"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In einem Durchgang!"
          }
        }
      }
    },
    "一遍过！录完后可以分享成片。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一遍过！录完后可以分享成片。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One take! Share your video when you're done recording."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一遍過！錄完後可以分享成片。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一発撮り成功！撮影が終わったら動画を共有しましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원테이크 성공! 녹화를 마치면 영상을 공유해 보세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In einem Durchgang! Teile dein Video nach der Aufnahme."
          }
        }
      }
    },
