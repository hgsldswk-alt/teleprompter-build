    "仅提词": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅提词"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prompt only"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅提詞"
          }
        },
        "ja": {
