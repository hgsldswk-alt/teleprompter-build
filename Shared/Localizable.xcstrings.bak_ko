{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "#提词器 #口播 #拍视频神器": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "#提词器 #口播 #拍视频神器"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "#Teleprompter #PublicSpeaking #VideoCreation"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "#提詞器 #口播 #拍片工具"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "#プロンプター #スピーチ #動画撮影"
          }
        }
      }
    },
    "%d 字 / 词": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%d 字 / 词"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%d characters / words"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%d 字 / 詞"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%d 文字 / 単語"
          }
        }
      }
    },
    "%d 条视频还没存到相册": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%d 条视频还没存到相册"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%d videos waiting to be saved"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%d 段影片尚未存入相簿"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存待ちの動画が%d本あります"
          }
        }
      }
    },
    "DOCX 文件损坏、已加密或格式不受支持。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "DOCX 文件损坏、已加密或格式不受支持。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This DOCX file is damaged, encrypted, or uses an unsupported format."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "DOCX 檔案損壞、已加密或格式不受支援。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このDOCXファイルは破損しているか、暗号化されているか、対応していない形式です。"
          }
        }
      }
    },
    "一次买断": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一次买断"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlock once"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一次買斷"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一度だけで解放"
          }
        }
      }
    },
    "一次买断，持续使用": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一次买断，持续使用"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One purchase. Yours to keep."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一次買斷，持續使用"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一度の購入で、ずっと使えます。"
          }
        }
      }
    },
    "一遍过！": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一遍过！"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One take!"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一遍過！"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一発撮り成功！"
          }
        }
      }
    },
    "一遍过！录完后可以分享成片。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一遍过！录完后可以分享成片。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One take! Share your video when you're done recording."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一遍過！錄完後可以分享成片。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一発撮り成功！撮影が終わったら動画を共有しましょう。"
          }
        }
      }
    },
    "不支持此文件格式。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不支持此文件格式。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This file format isn't supported."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不支援此檔案格式。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このファイル形式には対応していません。"
          }
        }
      }
    },
