    "请允许相机访问，或切换仅提词。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请允许相机访问，或切换仅提词。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow camera access, or switch to Prompt only."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請允許相機存取，或切換僅提詞。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラへのアクセスを許可するか、「プロンプトのみ」に切り替えてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카메라 접근을 허용하거나 프롬프트만 모드로 바꾸세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube den Kamerazugriff oder wechsle zu „Nur Prompter“."
          }
        },
        "es": {
