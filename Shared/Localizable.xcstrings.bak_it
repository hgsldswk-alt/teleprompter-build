    "悬浮提词使用匀速滚动，其他 App 可使用麦克风。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "悬浮提词使用匀速滚动，其他 App 可使用麦克风。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Floating mode scrolls at a constant speed, leaving the microphone available for other apps."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "懸浮提詞使用勻速捲動，其他 App 可使用麥克風。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フローティングモードは一定速度でスクロールし、マイクはほかのアプリで使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "플로팅 모드는 일정 속도로 스크롤되며 마이크는 다른 앱이 쓸 수 있습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im schwebenden Modus scrollt der Text konstant, damit andere Apps das Mikrofon nutzen können."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modo flotante se desplaza a velocidad constante y deja el micrófono libre para otras apps."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mode flottant défile à vitesse constante et laisse le micro disponible pour les autres apps."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O modo flutuante rola em velocidade constante e deixa o microfone livre para outros apps."
          }
        }
      }
    },
    "悬浮提词暂不可用，请在真机上重试。": {
