          "stringUnit": {
            "state": "translated",
            "value": "This script code exceeds 200 KB. Share a TXT file instead."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "稿件口令超過 200 KB，請改用 TXT 分享。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この原稿コードは200 KBを超えています。TXTファイルで共有してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대본 코드가 200 KB를 넘습니다. TXT 파일로 공유하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Skript-Code ist größer als 200 KB. Teile stattdessen eine TXT-Datei."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este código de guion supera los 200 KB. Comparte un archivo TXT en su lugar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce code de texte dépasse 200 Ko. Partage plutôt un fichier TXT."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este código de roteiro passa de 200 KB. Compartilhe um arquivo TXT."
          }
        }
      }
    },
