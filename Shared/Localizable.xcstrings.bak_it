    "拍摄模式支持音量键遥控（iOS 17.2 及以上）。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拍摄模式支持音量键遥控（iOS 17.2 及以上）。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Volume-button remotes work in Camera mode on iOS 17.2 or later."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拍攝模式支援音量鍵遙控（iOS 17.2 及以上）。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音量ボタン式のリモコンは、iOS 17.2以降のカメラモードで使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "볼륨 버튼 리모컨은 iOS 17.2 이상의 카메라 모드에서 작동합니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fernbedienungen über die Lautstärketasten funktionieren im Kameramodus ab iOS 17.2."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los controles con botones de volumen funcionan en modo Cámara desde iOS 17.2."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les télécommandes à bouton de volume fonctionnent en mode Caméra sous iOS 17.2 ou ultérieur."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Controles remotos com botão de volume funcionam no modo Câmera no iOS 17.2 ou posterior."
          }
        }
      }
    },
    "按一下翻页笔或键盘": {
      "localizations": {
