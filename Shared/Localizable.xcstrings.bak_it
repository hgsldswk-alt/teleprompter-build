    "按当前画质估算，剩余空间约可录 %d 分钟。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按当前画质估算，剩余空间约可录 %d 分钟。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At this quality, there's space for about %d minutes of recording."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按目前畫質估算，剩餘空間約可錄 %d 分鐘。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この画質だと、あと約%d分録画できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 화질이면 약 %d분 녹화할 수 있습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In dieser Qualität ist Platz für etwa %d Minuten Aufnahme."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con esta calidad hay espacio para unos %d minutos de grabación."
          }
        },
        "fr": {
