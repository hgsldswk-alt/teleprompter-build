          }
        }
      }
    },
    "一次买断，持续使用": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一次买断，持续使用"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One purchase. Yours to keep."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一次買斷，持續使用"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一度の購入で、ずっと使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 번 구매로 계속 사용"
          }
