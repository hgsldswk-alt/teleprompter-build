    "视频仍保留在应用内，请腾出空间后重试。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "视频仍保留在应用内，请腾出空间后重试。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your video is still in the app. Free some storage and try again."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "影片仍保留在應用程式內，請騰出空間後重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "動画はまだアプリ内にあります。ストレージを空けてもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "영상은 아직 앱 안에 있습니다. 저장 공간을 비우고 다시 시도하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Video ist noch in der App. Gib Speicher frei und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu video sigue en la app. Libera espacio e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta vidéo est toujours dans l’app. Libère de l’espace et réessaie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu vídeo continua no app. Libere espaço e tente novamente."
          }
        }
      }
    },
    "视频原文件保存在应用内。允许添加到相册后可重试，也可通过分享导出。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "视频原文件保存在应用内。允许添加到相册后可重试，也可通过分享导出。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Original videos stay in the app. Allow access to add to Photos and retry, or export using Share."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "影片原始檔保存在應用程式內。允許加入相簿後可重試，也可透過分享匯出。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元の動画はアプリ内に残っています。写真への追加を許可して再試行するか、共有から書き出してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원본 영상은 앱 안에 남아 있습니다. 사진 접근을 허용하고 다시 시도하거나 공유로 내보내세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Originalvideos bleiben in der App. Erlaube den Zugriff zum Hinzufügen zu Fotos und versuche es erneut oder exportiere über Teilen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los videos originales se quedan en la app. Permite el acceso para agregarlos a Fotos y reintenta, o expórtalos con Compartir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les vidéos d’origine restent dans l’app. Autorise l’accès pour les ajouter à Photos et réessaie, ou exporte via Partager."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os vídeos originais ficam no app. Permita o acesso para adicionar às Fotos e tente de novo, ou exporte com Compartilhar."
          }
        }
      }
    },
    "视频已保留在待保存，可重试或分享导出。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "视频已保留在待保存，可重试或分享导出。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your video is in Pending videos. Retry saving or export it with Share."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "影片已保留在待儲存，可重試或分享匯出。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
