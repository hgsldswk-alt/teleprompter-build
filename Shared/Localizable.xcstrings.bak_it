    "卡壳也会等你，读到哪里跟到哪里。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "卡壳也会等你，读到哪里跟到哪里。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It waits when you pause and follows as you speak."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "卡住也會等你，讀到哪裡跟到哪裡。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "話を止めると待ち、話すと追いかけます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "말을 멈추면 기다리고, 말하면 따라옵니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wartet, wenn du pausierst, und folgt, wenn du sprichst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Espera cuando haces una pausa y te sigue cuando hablas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il attend quand tu fais une pause et te suit quand tu parles."
