    },
    "此语言的设备端识别不可用，已切换匀速。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此语言的设备端识别不可用，已切换匀速。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On-device recognition isn't available for this language. Switched to constant scrolling."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此語言的裝置端辨識不可用，已切換勻速。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この言語は端末上で認識できません。一定速度のスクロールに切り替えました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 언어는 기기 내 인식을 지원하지 않습니다. 일정 속도 스크롤로 바꿨습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für diese Sprache gibt es keine Erkennung auf dem Gerät. Auf konstantes Scrollen umgestellt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El reconocimiento en el dispositivo no está disponible para este idioma. Se cambió a desplazamiento constante."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La reconnaissance sur l’appareil n’est pas disponible pour cette langue. Passage au défilement constant."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O reconhecimento no dispositivo não está disponível para este idioma. Mudou para rolagem constante."
          }
        }
      }
    },
