            "state": "translated",
            "value": "Autorise l’accès à la caméra ou passe en mode Prompteur seul."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita o acesso à câmera ou mude para Só o teleprompter."
          }
        }
      }
    },
