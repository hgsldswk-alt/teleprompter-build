          "stringUnit": {
            "state": "translated",
            "value": "Ein Kauf. Für immer deins."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una compra. Tuya para siempre."
          }
        },
        "fr": {
          "stringUnit": {
