          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "영상은 저장 대기 영상에 있습니다. 다시 저장하거나 공유로 내보내세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Video liegt unter Wartende Videos. Sichere es erneut oder exportiere es über Teilen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu video está en Videos pendientes. Vuelve a guardarlo o expórtalo con Compartir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta vidéo est dans Vidéos en attente. Réessaie l’enregistrement ou exporte-la via Partager."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu vídeo está em Vídeos pendentes. Tente salvar de novo ou exporte com Compartilhar."
