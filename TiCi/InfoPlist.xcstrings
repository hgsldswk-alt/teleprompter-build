{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "CFBundleDisplayName": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提词器"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Teleprompter"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "提詞器"
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于在手机上拍摄提词视频。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record video while reading your script on your iPhone."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用於在手機上拍攝提詞影片。"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于录制视频声音和设备端语音跟随。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record audio for your videos and follow your voice on your device."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用於錄製影片聲音和裝置端語音跟隨。"
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "语音跟随只在手机上识别，不上传音频或稿件。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Voice follow recognizes speech only on your iPhone. Audio and scripts are never uploaded."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "語音跟隨只在手機上辨識，不上傳音訊或稿件。"
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于将你录制的视频添加到相册。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add your recorded videos to your photo library."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用於將你錄製的影片加入相簿。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
