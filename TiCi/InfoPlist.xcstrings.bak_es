{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "CFBundleDisplayName": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提词器"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Teleprompter"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "提詞器"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロンプター"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "텔레프롬프터"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Teleprompter"
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于在手机上拍摄提词视频。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record video while reading your script on your iPhone."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用於在手機上拍攝提詞影片。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhoneで原稿を読みながら動画を撮影します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone에서 대본을 보며 영상을 촬영합니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimmt Video auf, während du dein Skript auf dem iPhone liest."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于录制视频声音和设备端语音跟随。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record audio for your videos and follow your voice on your device."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用於錄製影片聲音和裝置端語音跟隨。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "動画の音声を録音し、端末上であなたの声に合わせて原稿を進めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "영상 소리를 녹음하고 기기에서 목소리에 맞춰 대본을 넘깁니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimmt Ton für deine Videos auf und folgt deiner Stimme auf dem Gerät."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "语音跟随只在手机上识别，不上传音频或稿件。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Voice follow recognizes speech only on your iPhone. Audio and scripts are never uploaded."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "語音跟隨只在手機上辨識，不上傳音訊或稿件。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声追従はiPhone上だけで音声を認識します。音声や原稿がアップロードされることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음성 따라가기는 iPhone에서만 음성을 인식합니다. 음성이나 대본은 업로드되지 않습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sprachverfolgung erkennt Sprache nur auf deinem iPhone. Audio und Skripte werden nie hochgeladen."
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于将你录制的视频添加到相册。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add your recorded videos to your photo library."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用於將你錄製的影片加入相簿。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録画した動画を写真ライブラリに追加します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹화한 영상을 사진 보관함에 추가합니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügt deine aufgenommenen Videos zur Fotomediathek hinzu."
          }
        }
      }
    }
  },
  "version": "1.0"
}
